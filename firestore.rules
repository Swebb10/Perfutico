rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /users/{uid}/favorites/{productId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }
    match /users/{uid}/suggestions/{suggestionId} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['text', 'status', 'userId', 'email', 'displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['text', 'status', 'userId', 'email', 'displayName', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1200
        && request.resource.data.status == 'nueva'
        && request.resource.data.userId == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status == 'revisada'
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    // Required for collectionGroup('suggestions') used by the admin inbox.
    // Keep the wildcard scoped to the users/{uid}/suggestions hierarchy.
    match /{path=**}/suggestions/{suggestionId} {
      allow read: if isAdmin() && path.matches('^users/[^/]+$');
    }
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasOnly(['customerName','phone','address','items','total','status','createdAt','userId'])
        && request.resource.data.keys().hasAll(['customerName','phone','address','items','total','status','createdAt'])
        && request.resource.data.customerName is string && request.resource.data.customerName.size() > 0 && request.resource.data.customerName.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 30
        && request.resource.data.address is string && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 500
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.status == 'pendiente'
        && request.resource.data.createdAt == request.time
        && (!('userId' in request.resource.data) || (signedIn() && request.resource.data.userId == request.auth.uid));
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pendiente', 'sinpe_confirmado', 'preparando', 'enviado', 'completado', 'cancelado']
        && request.resource.data.updatedAt == request.time;
    }
  }
}
